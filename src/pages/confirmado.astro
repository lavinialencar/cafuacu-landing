---
import proxima from "../data/proxima-edicao.json";
// /confirmado · página pra onde o Brevo leva a pessoa direto depois do clique de confirmação (redirectionUrl).
import Pagina from "../layouts/Pagina.astro";
import Filtros from "../components/Filtros.astro";
import Ilustracao from "../components/Ilustracao.astro";
---
<Pagina
  titulo="Confirmado! Você está na lista do Cafuaçu"
  descricao="Inscrição confirmada na newsletter quinzenal de café do Cafuaçu."
  noindex
>
  <Fragment slot="hero">
    <div class="eyebrow">inscrição confirmada</div>
    <h1>Confirmado.<br />Você está na lista.</h1>
    <p>A próxima edição chega <strong style="color:var(--torra-500)">{proxima.texto}</strong>, e depois é de quinze em quinze dias.</p>
  </Fragment>

  <Filtros />

  <div class="cab">
    <div class="eyebrow">primeiro, uma coisa importante</div>
    <h2>Salva a gente nos contatos</h2>
  </div>
  <div class="salvar">
    <code id="remetente">newsletter@mail.cafuacu.com.br</code>
    <button class="copiar" type="button" id="copiar">copiar</button>
    <p>Assim a newsletter não cai no spam nem na aba Promoções.</p>
  </div>

  <div class="cab" style="margin-top:44px">
    <div class="eyebrow">enquanto a próxima edição não chega</div>
    <h2>Já tem coisa boa no ar</h2>
  </div>
  <div class="tiles">
    <a class="tile" href="https://t.me/cafuacu_ofertas" target="_blank" rel="noopener">
      <span class="etq">no ar</span>
      <div class="ilu"><Ilustracao nome="maos" /></div>
      <strong>Canal de ofertas</strong>
      <p>Promoção de café e equipamento, garimpada pela cafetinha.</p>
    </a>
    <a class="tile" href="/guias/equipamento">
      <span class="etq">no ar</span>
      <div class="ilu"><Ilustracao nome="coador" /></div>
      <strong>Guia de equipamento</strong>
      <p>Quer comprar um moedor e não sabe qual? Aqui tem opção pra cada orçamento.</p>
    </a>
    <div class="tile">
      <span class="etq">no ar</span>
      <div class="ilu"><Ilustracao nome="ramo" /></div>
      <strong>Começar no café especial</strong>
      <p>O caminho curto pra sair do pó e chegar no grão bom.</p>
    </div>
  </div>

  <div class="cab" style="margin-top:44px">
    <div class="eyebrow">e já que está aqui</div>
    <h2>Marca a gente</h2>
  </div>
  <ul class="linhas">
    <li>
      <a class="linha" href="https://instagram.com/cafuacu" target="_blank" rel="noopener">
        <span class="txt"><strong>Instagram, @cafuacu</strong><span class="d">Postou café? Marca a gente que a cafetinha vai lá ver.</span></span>
        <span class="etq ir">abrir</span>
      </a>
    </li>
  </ul>

  <Fragment slot="fecho">
    <h2>Quer ler uma edição?</h2>
    <p>Tem uma pronta, sem esperar.</p>
    <a class="botao" href="/edicoes/2026-09-19/">ler uma edição agora ☕</a>
  </Fragment>

  <div class="chuva" id="chuva" aria-hidden="true" slot="hero"></div>
  <script>
    // Grãozinhos caem uma vez quando a página abre. Sem "reduzir movimento".
    const chuva = document.getElementById("chuva");
    if (chuva && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
      for (let i = 0; i < 16; i++) {
        const g = document.createElement("i");
        g.style.left = 4 + Math.random() * 92 + "%";
        g.style.animationDelay = (Math.random() * 0.7).toFixed(2) + "s";
        g.style.animationDuration = (1.5 + Math.random() * 1.0).toFixed(2) + "s";
        chuva.appendChild(g);
      }
      setTimeout(() => (chuva.innerHTML = ""), 3600);
    }
  </script>
  <script>
    const btn = document.getElementById("copiar");
    const alvo = document.getElementById("remetente");
    if (btn && alvo) {
      btn.addEventListener("click", async () => {
        try { await navigator.clipboard.writeText(alvo.textContent.trim()); btn.textContent = "copiado"; }
        catch { const r = document.createRange(); r.selectNodeContents(alvo); const s = getSelection(); s.removeAllRanges(); s.addRange(r); btn.textContent = "selecionado"; }
        setTimeout(() => (btn.textContent = "copiar"), 2000);
      });
    }
  </script>
</Pagina>
