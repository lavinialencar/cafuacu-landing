---
// /guias · índice dos guias. Publicado vira link; rascunho aparece como "em breve", sem página.
import Pagina from "../../layouts/Pagina.astro";
import { getCollection } from "astro:content";
const todos = (await getCollection("guias")).sort((a, b) => a.data.ordem - b.data.ordem);
const publicados = todos.filter((g) => g.data.estado === "publicado");
const chegando = todos.filter((g) => g.data.estado !== "publicado");
---
<Pagina titulo="Guias de café especial · Cafuaçu" descricao="Guias de café especial pra quem está começando: o que é café especial, como escolher, preparar e qual equipamento comprar." faixa="democratizando o acesso ao café especial ☕">
  <Fragment slot="hero">
    <div class="eyebrow">pra quem está começando</div>
    <h1>Guias</h1>
    <p>Café sem enrolação, do começo.</p>
  </Fragment>

  <div class="cab">
    <div class="eyebrow">pra ler agora</div>
    <h2>Escolhe um guia</h2>
  </div>
  {publicados.length ? (
    <ul class="linhas">
      {publicados.map((g) => (
        <li>
          <a class="linha" href={`/guias/${g.id}`}>
            <span class="txt"><strong>{g.data.titulo}</strong><span class="d">{g.data.resumo}</span></span>
            <span class="etq ir">ler</span>
          </a>
        </li>
      ))}
    </ul>
  ) : null}
  {chegando.length > 0 && (
    <>
      <div class="cab">
        <div class="eyebrow">chegando</div>
        <h2>{publicados.length ? "E os próximos" : "Os primeiros guias estão a caminho"}</h2>
      </div>
      <ul class="linhas">
        {chegando.map((g) => (
          <li>
            <div class="linha inativo">
              <span class="txt"><strong>{g.data.titulo}</strong><span class="d">{g.data.resumo}</span></span>
              <span class="etq breve">em breve</span>
            </div>
          </li>
        ))}
      </ul>
    </>
  )}

  <Fragment slot="fecho">
    <h2>Quer saber quando saírem?</h2>
    <p>Assine a newsletter, toda quinzena, sem enrolação.</p>
    <a class="botao" href="/newsletter">quero receber</a>
  </Fragment>
</Pagina>
