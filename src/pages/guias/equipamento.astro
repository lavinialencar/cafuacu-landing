<script>
  // Sumário do topo: destaca a seção da tela, abre a linha de categorias em "Onde comprar" e mostra o progresso da leitura.
  const nav = document.getElementById("topo-sum")!;
  const chips = Array.from(nav.querySelectorAll<HTMLAnchorElement>(".ts-chips a[data-alvo]"));
  const subs = Array.from(nav.querySelectorAll<HTMLAnchorElement>(".ts-sub a[data-alvo]"));
  const secIds = chips.map((a) => a.dataset.alvo!);
  const catIds = subs.map((a) => a.dataset.alvo!);
  const barra = nav.querySelector<HTMLElement>(".progresso i");
  const el = (id: string) => document.getElementById(id);
  function atual(ids: string[], topo: number) {
    let r: string | undefined;
    for (const id of ids) { const e = el(id); if (e && e.getBoundingClientRect().top + window.scrollY <= topo) r = id; }
    return r;
  }
  function atualiza() {
    const topo = window.scrollY + nav.offsetHeight + 140;
    const cat = atual(catIds, topo);
    let sec = atual(secIds, topo);
    const emCategorias = !!cat && sec === "equipamentos";
    nav.classList.toggle("mostra-sub", emCategorias);
    chips.forEach((a) => a.classList.toggle("ativo", a.dataset.alvo === sec));
    subs.forEach((a) => a.classList.toggle("ativo", emCategorias && a.dataset.alvo === cat));
    const ativo = chips.find((a) => a.dataset.alvo === sec);
    if (ativo) { const box = ativo.closest(".ts-chips") as HTMLElement; box.scrollTo({ left: ativo.offsetLeft - box.clientWidth / 2 + ativo.clientWidth / 2, behavior: "auto" }); }
    const h = document.documentElement.scrollHeight - window.innerHeight;
    if (barra && h > 0) barra.style.width = Math.min(100, (window.scrollY / h) * 100).toFixed(1) + "%";
  }
  window.addEventListener("scroll", atualiza, { passive: true });
  window.addEventListener("resize", atualiza);
  atualiza();
</script>

<script>
  // Aparece ao rolar: só quando o site ligou "anim" (sem "reduzir movimento"). O que já está na tela abre direto.
  (function () {
    if (!document.documentElement.classList.contains("anim")) return;
    if (!("IntersectionObserver" in window)) return;
    const alvos = document.querySelectorAll(".cab-sec, .sub, .abre, .escolha-orc, .cat-cab, .passos li, .cartao, .prod, .master, .escolha, .pula > *, .receita, .formula, .rec-cols > *, .app, .transp, .canal-final, .escada");
    const cont = new Map();
    let disparou = false;
    const obs = new IntersectionObserver((itens) => {
      disparou = true;
      itens.forEach((it) => { if (it.isIntersecting) { it.target.classList.add("vis"); obs.unobserve(it.target); } });
    }, { threshold: 0.12, rootMargin: "0px 0px -6% 0px" });
    alvos.forEach((a) => {
      const i = cont.get(a.parentElement) || 0;
      cont.set(a.parentElement, i + 1);
      a.style.setProperty("--i", String(Math.min(i, 5)));
      const r = a.getBoundingClientRect();
      if (r.top < innerHeight && r.bottom > 0) { a.classList.add("vis"); return; }
      a.classList.add("rv");
      obs.observe(a);
    });
    setTimeout(() => { if (!disparou) alvos.forEach((a) => a.classList.add("vis")); }, 3500);
  })();
</script>
