// Botões de compra: por enquanto abrem a BUSCA do produto na loja (simulação até haver afiliado).
// Quando os afiliados existirem, trocar `lojas()` por links reais por produto.
const enc = encodeURIComponent;
const lojas = (q: string) => [
  { id: "ali", nome: "AliExpress", href: `https://pt.aliexpress.com/wholesale?SearchText=${enc(q)}` },
  { id: "amz", nome: "Amazon", href: `https://www.amazon.com.br/s?k=${enc(q)}` },
  { id: "ml", nome: "Mercado Livre", href: `https://lista.mercadolivre.com.br/${q.trim().toLowerCase().replace(/\s+/g, "-")}` },
];

