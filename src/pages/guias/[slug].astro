---
// /guias/<slug> · uma página por guia publicado.
import Pagina from "../../layouts/Pagina.astro";
import { getCollection, render } from "astro:content";
export async function getStaticPaths() {
  const guias = await getCollection("guias", (g) => g.data.estado === "publicado");
  return guias.map((g) => ({ params: { slug: g.id }, props: { g } }));
}
const { g } = Astro.props;
const { Content } = await render(g);
---
<Pagina titulo={`${g.data.titulo} · Cafuaçu`} descricao={g.data.resumo}>
  <Fragment slot="hero">
    <div class="eyebrow">guia</div>
    <h1>{g.data.titulo}</h1>
    <p>{g.data.resumo}</p>
  </Fragment>
  <div class="prosa"><Content /></div>
  <Fragment slot="fecho">
    <h2>Gostou?</h2>
    <p>Todo mês tem mais, na newsletter.</p>
    <a class="botao" href="/newsletter">quero receber</a>
  </Fragment>
</Pagina>
