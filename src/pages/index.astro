---
// / · o hub: porta de entrada do site (é o link da bio do Instagram). Cartões em src/data/hub.json.
import Pagina from "../layouts/Pagina.astro";
import itens from "../data/hub.json";
---
<Pagina
  titulo="Cafuaçu · café conecta, a gente também"
  descricao="Newsletter quinzenal, guias, canal de ofertas e loja de quem garimpa café especial."
  faixa="democratizando o acesso ao café especial ☕"
>
  <Fragment slot="hero">
    <div class="eyebrow">tudo da Cafuaçu num lugar só</div>
    <h1>Café conecta.<br />A gente também.</h1>
    <p>Newsletter, guias, ofertas e loja, do jeito simples de sempre.</p>
  </Fragment>

  <div class="cab">
    <div class="eyebrow">clica e vai</div>
    <h2>Por onde começar</h2>
  </div>
  <ul class="linhas">
    {itens.map((i) => (
      <li>
        {i.href && i.estado === "no ar" ? (
          <a class="linha" href={i.href} target={i.href.startsWith("http") ? "_blank" : undefined} rel={i.href.startsWith("http") ? "noopener" : undefined}>
            <span class="txt"><strong>{i.titulo}</strong><span class="d">{i.texto}</span></span>
            <span class="etq ir">abrir</span>
          </a>
        ) : (
          <div class="linha inativo">
            <span class="txt"><strong>{i.titulo}</strong><span class="d">{i.texto}</span></span>
            <span class="etq breve">em breve</span>
          </div>
        )}
      </li>
    ))}
  </ul>

  <Fragment slot="fecho">
    <h2>Ainda não assinou?</h2>
    <p>Toda quinzena, sem enrolação.</p>
    <a class="botao" href="/newsletter">quero receber</a>
  </Fragment>
</Pagina>
