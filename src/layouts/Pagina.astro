---
// Moldura das páginas do site (visual da landing): topo escuro, faixa âmbar opcional,
// corpo claro, fecho escuro opcional e rodapé claro.
// Slots: "hero" (título e texto do topo), padrão (corpo), "fecho" (faixa escura final).
import Base from "./Base.astro";
import Mascote from "../components/Mascote.astro";
import Logo from "../components/Logo.astro";
import Rodape from "../components/Rodape.astro";
import VoltarHub from "../components/VoltarHub.astro";
import "../styles/pagina.css";
interface Props { titulo: string; descricao?: string; noindex?: boolean; faixa?: string; semVoltar?: boolean; largo?: boolean; compacto?: boolean; }
const { faixa, semVoltar = false, largo = false, compacto = false, ...resto } = Astro.props;
const naoEHub = !["", "/", "/index.html", "/index"].includes(Astro.url.pathname);
---
<Base {...resto}>
  <section class={compacto ? "hero compacto" : "hero"}>
    {naoEHub && !semVoltar && <VoltarHub />}
    <div class="hero-in">
      <a class="marca" href="/">
        <Mascote />
        <Logo largura={compacto ? 132 : 170} />
      </a>
      <slot name="hero" />
    </div>
  </section>
  {faixa && <div class="faixa"><div>{faixa}</div></div>}
  <section class="corpo">
    <div class={largo ? "corpo-in largo" : "corpo-in"}>
      <slot />
    </div>
  </section>
  {Astro.slots.has("fecho") && (
    <section class="fecho"><div class="fecho-in"><slot name="fecho" /></div></section>
  )}
  <Rodape />
  <script>import "../scripts/reveal.js";</script>
</Base>
