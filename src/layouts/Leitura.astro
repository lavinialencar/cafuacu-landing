---
// Texto longo e claro: política de privacidade e guias.
import Base from "./Base.astro";
import "../styles/leitura.css";
interface Props { titulo: string; descricao?: string; noindex?: boolean; voltar?: { href: string; texto: string }; }
const { voltar = { href: "/", texto: "voltar pra Cafuaçu" }, ...resto } = Astro.props;
---
<Base {...resto}>
  <div class="env">
    <a class="voltar" href={voltar.href}>{voltar.texto}</a>
    <slot />
    <div class="fecho">Cafuaçu · newsletter quinzenal de café</div>
  </div>
</Base>
