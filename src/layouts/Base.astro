---
// Casca comum a todas as páginas: <head>, fonte, ícones e tokens da marca.
import "../styles/tokens.css";
interface Props { titulo: string; descricao?: string; noindex?: boolean; }
const { titulo, descricao, noindex = false } = Astro.props;
// Endereço oficial da página (sem barra no fim, igual ao trailingSlash "never" do site).
const caminho = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "").replace(/\/$/, "");
const canonico = new URL(caminho || "/", Astro.site).href;
---
<!doctype html>
<html lang="pt-BR" style="color-scheme:light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{titulo}</title>
  {descricao && <meta name="description" content={descricao} />}
  {noindex && <meta name="robots" content="noindex" />}
  {!noindex && <link rel="canonical" href={canonico} />}
  <meta property="og:site_name" content="Cafuaçu" />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={titulo} />
  {descricao && <meta property="og:description" content={descricao} />}
  <meta property="og:url" content={canonico} />
  <meta property="og:image" content="https://cafuacu.com.br/og.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#2E1E17" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet" />
  <script is:inline>
    try{ if(!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("anim"); }catch(e){}
  </script>
  <script is:inline>
    // Guarda os UTM de quem chegou por anuncio, pra inscricao levar mesmo se a pessoa
    // passear pelo site antes de assinar. So vale na aba (sessionStorage). A funcao revalida tudo.
    try{
      var q=new URLSearchParams(location.search),u={},tem=false;
      ["utm_source","utm_medium","utm_campaign","utm_content"].forEach(function(k){
        var v=(q.get(k)||"").trim().toLowerCase();
        if(/^[a-z0-9_-]{1,60}$/.test(v)){u[k]=v;tem=true;}
      });
      if(tem) sessionStorage.setItem("cafuacu_utm",JSON.stringify(u));
    }catch(e){}
  </script>
  <slot name="head" />
</head>
<body>
  <a class="pular-pro-conteudo" href="#conteudo">Pular para o conteúdo</a>
  <slot />
</body>
</html>
