---
// Páginas curtas e escuras: mascote no topo, conteúdo centralizado, rodapé escuro.
import Base from "./Base.astro";
import Mascote from "../components/Mascote.astro";
import Logo from "../components/Logo.astro";
import Rodape from "../components/Rodape.astro";
import "../styles/casa.css";
interface Props { titulo: string; descricao?: string; noindex?: boolean; }
const props = Astro.props;
---
<Base {...props}>
  <main>
    <div class="miolo">
      <a class="marca" href="/">
        <Mascote />
        <Logo largura={148} />
      </a>
      <slot />
    </div>
  </main>
  <Rodape />
</Base>
